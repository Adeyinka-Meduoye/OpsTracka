rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /opstrack_users/{userId} {
      allow read, write: if true;
    }
    match /opstrack_projects/{projectId} {
      allow read, write: if true;
    }
    match /opstrack_entries/{entryId} {
      allow read, write: if true;
    }
  }
}
